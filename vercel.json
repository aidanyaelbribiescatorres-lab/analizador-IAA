{
  "functions": {
    "api/players.py": {
      "runtime": "python3.12",
      "maxDuration": 30
    },
    "api/live.py": {
      "runtime": "python3.12",
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" }
      ]
    }
  ]
}
